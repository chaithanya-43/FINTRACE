APP_NAME=FINTRACE
ENVIRONMENT=development
DEBUG=true
DATABASE_URL=<PROVIDE_POSTGRESQL_CONNECTION_URL>

# Authentication. Generate a real secret before any non-local deployment:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<PROVIDE_LONG_RANDOM_SECRET>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=120

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Evidence storage. Files are private and never served from a public directory.
STORAGE_ROOT=storage
MAX_UPLOAD_BYTES=10485760
ALLOWED_EVIDENCE_TYPES=application/pdf,image/png,image/jpeg,image/webp,text/plain,application/zip,application/octet-stream

# Optional Ed25519 evidence signing. Leave unset to report signing as unavailable.
# ED25519_KEY_ID=<PROVIDE_KEY_IDENTIFIER>
# ED25519_PRIVATE_KEY_B64=<PROVIDE_BASE64_32_BYTE_SEED>
# ED25519_PUBLIC_KEY_B64=<PROVIDE_BASE64_32_BYTE_PUBLIC_KEY>
